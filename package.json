{
  "name": "dsh-browser-use",
  "version": "0.2.0",
  "description": "Integrated browser for DeepSeek Harness: the agent drives Chrome and you watch it live in the right Sidebar, with a visible agent cursor.",
  "type": "module",
  "license": "MIT",
  "author": "Gustavo Costa",
  "keywords": [
    "deepseek",
    "dsh",
    "browser-use",
    "chrome",
    "playwright",
    "mcp",
    "agent",
    "mirror",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guhcostan/dsh-browser-use.git"
  },
  "bugs": {
    "url": "https://github.com/guhcostan/dsh-browser-use/issues"
  },
  "homepage": "https://github.com/guhcostan/dsh-browser-use#readme",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/check.sh",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-browser-use": "0.2.1-rc.3",
    "@deepseek-ai/dsh-experimental-browser-use-playwright-mcp": "0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
